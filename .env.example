# --- Required ---------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"

# --- Optional: AI assistant (Brain) ------------------------------------------
# Without a key, Brain runs on transparent built-in rules and says so.
# With a key, it calls your OpenAI-compatible endpoint from the server only.
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- Optional: real authentication (not yet wired) ----------------------------
# When configured, replace the local-profile session adapter in
# src/server/session.ts with Supabase Auth and enable RLS on all tables.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."   # server-side only
