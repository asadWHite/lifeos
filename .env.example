# LifeOS — example environment configuration (no secrets committed)
# Copy to .env and fill in. Framework: Next.js → NEXT_PUBLIC_ vars are
# inlined into the browser bundle at build time.

# PostgreSQL connection (required for all data + email auth).
# Local dev: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production with Supabase: Supabase Dashboard → Settings → Database →
# Connection string (session pooler, port 6543). Any of these names work —
# the app resolves them in order (no need to set all):
#   DATABASE_URL, SUPABASE_POSTGRES_URL_NON_POOLING, SUPABASE_POSTGRES_URL,
#   POSTGRES_URL, POSTGRES_URL_NON_POOLING
# The Vercel↔Supabase integration injects SUPABASE_POSTGRES_URL* automatically
# when projects are linked (Project → Integrations → Supabase → Connect).
DATABASE_URL=

# Supabase (public web config; safe in browsers — access is gated by RLS).
# URL: Supabase Dashboard → Settings → API → Project URL.
# Key: publishable (sb_publishable_*) — NEVER the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase Web SDK configuration — Google sign-in via Firebase Authentication.
# These values are public by design (identical to what any browser ships);
# access control comes from Firebase Auth rules + authorized domains, so
# committing them is safe, but keep them in env vars for flexibility.
# Firebase Console → Project lifeos-8bac1 → Project settings → Your web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
