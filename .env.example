# --- Required ---------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"

# --- Optional: AI assistant (Brain) ------------------------------------------
# Without a key, Brain runs on transparent built-in rules and says so.
# With a key, it calls your OpenAI-compatible endpoint from the server only.
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- Supabase Configuration --------------------------------------------------
# Get these from Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# DATABASE_URL is required for Drizzle ORM to connect to Supabase DB.
# IMPORTANT: this is NOT any of the API keys shown under Settings -> API.
# Get it from Supabase -> Settings -> Database -> Connection string (URI)
# Recommended on Vercel: use the pooler / SSL-enabled URI when Supabase offers it.
# Example direct URI:
# DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require"
# Example pooler URI:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require"
